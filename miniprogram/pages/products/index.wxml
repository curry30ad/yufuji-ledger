<view class="page">
  <view class="card">
    <view class="section-title">{{form.id ? '编辑商品' : '新增商品'}}</view>
    <view class="field"><text class="label">商品名称</text><input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" /></view>
    <view class="field">
      <text class="label">销售方式</text>
      <picker range="{{['按份/个','按重量']}}" bindchange="onModeChange">
        <view class="picker">{{form.saleMode === 'piece' ? '按份/个' : '按重量'}}</view>
      </picker>
    </view>
    <view class="field"><text class="label">单位</text><input class="input" value="{{form.unit}}" data-field="unit" bindinput="onInput" /></view>
    <view class="field"><text class="label">默认单价</text><input class="input" value="{{form.price}}" data-field="price" bindinput="onInput" /></view>
    <view class="field"><text class="label">排序</text><input class="input" value="{{form.sortOrder}}" data-field="sortOrder" bindinput="onInput" /></view>
    <view class="field">
      <text class="label">状态</text>
      <switch checked="{{form.isActive}}" bindchange="onStatusChange" />
    </view>
    <view class="btn-row">
      <button class="primary-btn" bindtap="saveItem">保存商品</button>
      <button class="ghost-btn" bindtap="resetForm">清空表单</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">商品列表</view>
    <view wx:if="{{items.length}}">
      <view class="list-item" wx:for="{{items}}" wx:key="id">
        <view class="item-title">{{item.name}} · ¥{{item.price}}</view>
        <view class="item-meta">{{item.saleMode === 'piece' ? '按份/个' : '按重量'}} ｜ {{item.unit}} ｜ {{item.isActive ? '启用' : '停用'}}</view>
        <button class="ghost-btn" size="mini" data-id="{{item.id}}" bindtap="editItem">编辑</button>
      </view>
    </view>
    <view class="empty" wx:else>还没有商品</view>
  </view>
</view>
