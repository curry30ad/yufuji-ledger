page {
  background: #f7f2eb;
  color: #2b2118;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
}

.card {
  background: #fffaf3;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(77, 40, 12, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.subtle {
  color: #806b59;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat {
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
}

.stat-label {
  color: #8a735d;
  font-size: 24rpx;
}

.stat-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #5d4938;
  font-size: 24rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #eadfce;
}

.textarea {
  min-height: 160rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.primary-btn,
.ghost-btn,
.warn-btn {
  border-radius: 999rpx;
  padding: 0 28rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #8b1e1e;
  color: #fff;
}

.ghost-btn {
  background: #fff;
  color: #6c5440;
  border: 2rpx solid #e3d6c3;
}

.warn-btn {
  background: #c93b2c;
  color: #fff;
}

.list-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1e6d8;
}

.list-item:last-child {
  border-bottom: 0;
}

.item-title {
  font-weight: 700;
}

.item-meta {
  margin-top: 8rpx;
  color: #7d6855;
  font-size: 24rpx;
}

.nav-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.nav-btn {
  background: linear-gradient(135deg, #8b1e1e, #b0472f);
  color: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  min-height: 140rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

.nav-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty {
  color: #8a735d;
  text-align: center;
  padding: 36rpx 0;
}

.bar-row {
  margin-bottom: 16rpx;
}

.bar-track {
  margin-top: 8rpx;
  height: 16rpx;
  background: #f0e3d3;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #c67b32, #8b1e1e);
}
